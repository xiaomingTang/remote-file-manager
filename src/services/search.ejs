<!doctype html>
<html>

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <style>
    :root {
      color-scheme: light dark;
    }

    html,
    body {
      height: 100%;
    }

    body {
      box-sizing: border-box;
      display: flex;
      flex-direction: column;
      min-height: 0;
      max-width: 900px;
      margin: 0;
      padding: 8px 24px;
      overflow: hidden;
      color: var(--vscode-foreground);
      font-family: var(--vscode-font-family);
      font-size: var(--vscode-font-size);
    }

    h1 {
      font-size: 1.4em;
      font-weight: 600;
      margin: 0 0 16px;
    }

    label {
      display: block;
      margin: 14px 0 6px;
      color: var(--vscode-descriptionForeground);
    }

    input,
    select,
    button {
      box-sizing: border-box;
      color: var(--vscode-input-foreground);
      background: var(--vscode-input-background);
      border: 1px solid var(--vscode-input-border, var(--vscode-panel-border));
      font: inherit;
    }

    input {
      width: 100%;
      padding: 7px 9px;
    }

    #connection {
      width: 100%;
      padding: 7px 9px;
    }

    .field-row {
      display: flex;
      gap: 16px;
    }

    @media (max-width: 349px) {
      body {
        padding-right: 12px;
        padding-left: 12px;
      }

      .field-row {
        flex-direction: column;
        gap: 0;
      }
    }

    .field {
      flex: 1 1 0;
      min-width: 0;
    }

    .search-input {
      position: relative;
    }

    .search-input input {
      padding-right: 34px;
    }

    .pattern-input {
      display: flex;
      gap: 6px;
    }

    .pattern-input input {
      min-width: 0;
    }

    .number-input {
      max-width: 180px;
    }

    .icon-button {
      width: 32px;
      min-width: 32px;
      height: 32px;
      min-height: 32px;
      padding: 0;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    .filter-icon {
      display: inline-block;
      width: 14px;
      height: 14px;
      background: currentColor;
      clip-path: polygon(0 10%, 100% 10%, 62% 52%, 62% 90%, 38% 90%, 38% 52%);
    }

    .icon-button.active {
      color: var(--vscode-button-foreground);
      background: var(--vscode-button-background);
    }

    .help {
      position: relative;
      display: inline-flex;
      margin-left: 4px;
    }

    .help-button {
      width: 18px;
      height: 18px;
      padding: 0;
      border: 0;
      border-radius: 50%;
      font-size: .85em;
      line-height: 18px;
    }

    .tooltip {
      position: absolute;
      left: 0;
      top: 24px;
      z-index: 2;
      display: none;
      width: min(460px, 75vw);
      padding: 10px;
      border: 1px solid var(--vscode-panel-border);
      background: var(--vscode-editorWidget-background);
      box-shadow: 0 4px 12px var(--vscode-widget-shadow);
      font-size: .9em;
    }

    .help.open .tooltip {
      display: block;
    }

    .tooltip p {
      margin: 0 0 8px;
    }

    .tooltip table {
      width: 100%;
      border-collapse: collapse;
    }

    .tooltip th,
    .tooltip td {
      padding: 5px;
      border: 1px solid var(--vscode-panel-border);
      text-align: left;
      vertical-align: top;
    }

    .tooltip code,
    .search-options-summary code {
      font-family: var(--vscode-editor-font-family);
    }

    .clear {
      position: absolute;
      right: 5px;
      top: 50%;
      width: 26px;
      height: 26px;
      padding: 0;
      border: 0;
      background: transparent;
      color: var(--vscode-descriptionForeground);
      transform: translateY(-50%);
      cursor: pointer;
    }

    .search-row {
      display: flex;
      align-items: flex-end;
      gap: 8px;
    }

    .search-row .field {
      flex-grow: 1;
    }

    .search-actions {
      display: flex;
      gap: 8px;
    }

    #search {
      padding: 0;
    }

    .search-icon {
      display: inline-block;
      position: relative;
      width: 8px;
      height: 8px;
      border: 1.5px solid currentColor;
      border-radius: 50%;
    }

    .search-icon::after {
      content: "";
      position: absolute;
      right: -4px;
      bottom: -2px;
      width: 5px;
      height: 1.5px;
      background: currentColor;
      transform: rotate(45deg);
      transform-origin: left center;
    }

    #search.searching .search-icon {
      border-top-color: transparent;
      animation: search-spin 0.8s linear infinite;
    }

    #search.searching .search-icon::after {
      display: none;
    }

    @keyframes search-spin {
      to {
        transform: rotate(360deg);
      }
    }

    .more-icon {
      width: 16px;
      height: 16px;
      fill: none;
      stroke: currentColor;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .more-icon-expanded {
      display: none;
    }

    #toggleSearchOptions[aria-expanded="true"] .more-icon-collapsed {
      display: none;
    }

    #toggleSearchOptions[aria-expanded="true"] .more-icon-expanded {
      display: block;
    }

    button {
      padding: 6px 12px;
      cursor: pointer;
    }

    button:hover {
      background: var(--vscode-toolbar-hoverBackground);
    }

    button:disabled {
      opacity: .6;
      cursor: default;
    }

    .search-options[hidden] {
      display: none;
    }

    .search-options {
      margin-top: 4px;
    }

    .search-options-summary {
      display: none;
      margin: 10px 0 0;
      color: var(--vscode-descriptionForeground);
      font-size: .9em;
      line-height: 1.7;
      opacity: .75;
    }

    #searchOptions[hidden] + .search-options-summary {
      display: block;
      cursor: pointer;
      transition: color .15s ease, background .15s ease, opacity .15s ease;
    }

    #searchOptions[hidden] + .search-options-summary:hover {
      color: var(--vscode-foreground);
      background: var(--vscode-toolbar-hoverBackground);
      opacity: 1;
    }

    .summary {
      margin: 16px 0 8px;
      color: var(--vscode-descriptionForeground);
    }

    .result-tabs {
      display: flex;
      margin-top: 8px;
      border-bottom: 1px solid var(--vscode-panel-border);
    }

    .result-tab {
      flex: 1 1 0;
      padding: 8px 12px;
      border: 0;
      border-bottom: 2px solid transparent;
      color: var(--vscode-descriptionForeground);
      background: transparent;
      text-align: left;
    }

    .result-tab[aria-selected="true"] {
      border-bottom-color: var(--vscode-focusBorder);
      color: var(--vscode-foreground);
      font-weight: 600;
    }

    .result-tab:focus-visible {
      outline: 1px solid var(--vscode-focusBorder);
      outline-offset: -1px;
    }

    .result-columns {
      flex: 1 1 0;
      min-height: 0;
      overflow: hidden;
    }

    .result-section {
      display: flex;
      flex-direction: column;
      height: 100%;
      min-width: 0;
      min-height: 0;
      overflow: hidden;
    }

    .result-section[hidden] {
      display: none;
    }

    .results {
      flex-grow: 1;
      margin: 0;
      padding: 0;
      overflow: auto;
      list-style: none;
    }

    .result {
      border-top: 1px solid var(--vscode-panel-border);
    }

    .result button {
      display: block;
      width: 100%;
      padding: 10px 0;
      border: 0;
      text-align: left;
      background: transparent;
    }

    .result button:hover {
      color: var(--vscode-textLink-foreground);
    }

    .result-menu {
      position: fixed;
      z-index: 3;
      min-width: 160px;
      padding: 4px 0;
      border: 1px solid var(--vscode-menu-border, var(--vscode-panel-border));
      background: var(--vscode-menu-background);
      box-shadow: 0 2px 8px var(--vscode-widget-shadow);
    }

    .result-menu[hidden] {
      display: none;
    }

    .result-menu button {
      width: 100%;
      padding: 6px 12px;
      border: 0;
      color: var(--vscode-menu-foreground);
      background: transparent;
      text-align: left;
    }

    .result-menu button:hover,
    .result-menu button:focus-visible {
      color: var(--vscode-menu-selectionForeground);
      background: var(--vscode-menu-selectionBackground);
      outline: none;
    }

    .result.visited .name {
      color: var(--vscode-charts-purple, var(--vscode-descriptionForeground));
    }

    .name {
      display: block;
      font-weight: 600;
    }

    .path {
      display: block;
      margin-top: 3px;
      color: var(--vscode-descriptionForeground);
      overflow-wrap: anywhere;
    }

    .error {
      color: var(--vscode-errorForeground);
    }
  </style>
</head>
<body>
  <form id="searchForm">
    <div class="search-row">
      <div class="field">
        <label for="value">Name
          <span class="help" id="nameHelp">
            <button class="help-button" id="nameHelpButton" type="button" title="Show name pattern examples"
              aria-label="Show name pattern examples">?</button>
            <span class="tooltip" role="tooltip">
              <p>Patterns match file and directory names, ignoring case.</p>
              <table>
                <thead>
                  <tr>
                    <th>Pattern</th>
                    <th>Matches</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td><code>abc</code></td>
                    <td>Names containing <code>abc</code>, such as <code>Abcd</code> and <code>AABC</code>.</td>
                  </tr>
                  <tr>
                    <td><code>*.ts</code></td>
                    <td>Names containing <code>.ts</code>, such as <code>a.ts</code> and <code>a.tsx</code>.</td>
                  </tr>
                  <tr>
                    <td><code>foo?</code></td>
                    <td>Names containing <code>foo</code> followed by one character, such as <code>foox</code>.</td>
                  </tr>
                  <tr>
                    <td><code>foo[ab]</code></td>
                    <td>Names containing either <code>fooa</code> or <code>foob</code>.</td>
                  </tr>
                  <tr>
                    <td><code>^foo</code></td>
                    <td>Names starting with <code>foo</code>, or containing the literal text <code>^foo</code>.</td>
                  </tr>
                  <tr>
                    <td><code>foo$</code></td>
                    <td>Names ending with <code>foo</code>, or containing the literal text <code>foo$</code>.</td>
                  </tr>
                  <tr>
                    <td><code>^foo$</code></td>
                    <td>Names exactly equal to <code>foo</code>, or containing the literal text <code>^foo$</code>.</td>
                  </tr>
                </tbody>
              </table>
            </span>
          </span>
        </label>
        <div class="search-input">
          <input id="value" type="text" value="<%= defaultValue %>" autofocus />
          <button class="clear" id="clear" type="button" title="Clear search"
            aria-label="Clear search">&#10005;</button>
        </div>
      </div>
      <div class="search-actions">
        <button class="icon-button" id="search" type="submit" title="Search" aria-label="Search">
          <span class="search-icon" aria-hidden="true"></span>
        </button>
        <button class="icon-button" id="toggleSearchOptions" type="button" title="Show search options"
          aria-label="Show search options" aria-expanded="false" aria-controls="searchOptions">
          <svg class="more-icon more-icon-collapsed" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="5" r="1.5" fill="currentColor" stroke="none" />
            <circle cx="12" cy="12" r="1.5" fill="currentColor" stroke="none" />
            <circle cx="12" cy="19" r="1.5" fill="currentColor" stroke="none" />
          </svg>
          <svg class="more-icon more-icon-expanded" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 15L12 7L20 15" stroke-width="2" />
          </svg>
        </button>
      </div>
    </div>
    <div class="search-options" id="searchOptions" hidden>
      <div class="field-row">
        <div class="field">
          <label for="connection">Search in</label>
          <select id="connection">
            <% connections.forEach((connection)=> { %>
              <option value="<%= connection.id %>" <%=connection.id===defaultConnectionId ? "selected" : "" %>><%=
                  connection.id %>
              </option>
              <% }); %>
          </select>
        </div>
        <div class="field">
          <label for="directory">Search directory</label>
          <input id="directory" type="text" value="<%= defaultSearchDirectory %>" />
        </div>
      </div>
      <div class="field-row">
        <div class="field">
          <label for="maxResults">Maximum results
            <span class="help" id="maxResultsHelp">
              <button class="help-button" id="maxResultsHelpButton" type="button" title="Show maximum results information"
                aria-label="Show maximum results information">?</button>
              <span class="tooltip" role="tooltip">
                <p>This value applies only to the current search and is discarded when this page is closed.</p>
                <p>To save it for future searches, update <a href="#" id="openSearchSettings">VS Code settings</a>.</p>
              </span>
            </span>
          </label>
          <input id="maxResults" type="number" min="1" step="1" value="<%= defaultMaxResults %>" />
        </div>
        <div class="field">
          <label for="excludePatterns">Exclude patterns
            <span class="help" id="excludeHelp">
              <button class="help-button" id="helpButton" type="button" title="Show pattern examples"
                aria-label="Show pattern examples">?</button>
              <span class="tooltip" role="tooltip">
                <p>Patterns are relative to the search directory and separated with ",".</p>
                <table>
                  <thead>
                    <tr>
                      <th>Pattern</th>
                      <th>Description</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr>
                      <td><code>**/node_modules</code></td>
                      <td>Ignores <code>node_modules</code> and its subdirectories at any level (default exclude).</td>
                    </tr>
                    <tr>
                      <td><code>dist/**/*.map</code></td>
                      <td>Relative pattern that ignores <code>.map</code> files at any level under <code>dist</code>.</td>
                    </tr>
                    <tr>
                      <td><code>app</code></td>
                      <td>Relative pattern that matches the complete <code>./app</code> path, whether it is a file or
                        directory.</td>
                    </tr>
                  </tbody>
                </table>
              </span>
            </span>
          </label>
          <div class="pattern-input">
            <input id="excludePatterns" type="text" value="<%= defaultExcludePatterns %>"
              placeholder='Relative patterns, separated with ","' />
            <button class="icon-button" id="defaultExcludes" type="button" title="Use default exclude patterns"
              aria-label="Use default exclude patterns" aria-pressed="<%= useDefaultExcludePatterns %>"><span
                class="filter-icon" aria-hidden="true"></span></button>
          </div>
        </div>
      </div>
    </div>
    <p class="search-options-summary" id="searchOptionsSummary" title="Double-click to show search options">Search in <code id="searchDirectorySummary"></code>,
      up to <code id="maxResultsSummary"></code> results, excluding <code id="excludePatternsSummary"></code>.</p>
  </form>
  <div class="summary" id="summary" aria-live="polite"></div>
  <div class="result-tabs" role="tablist" aria-label="Search results">
    <button class="result-tab" id="filesTab" type="button" role="tab" aria-selected="true"
      aria-controls="filesPanel">Files (0)</button>
    <button class="result-tab" id="directoriesTab" type="button" role="tab" aria-selected="false"
      aria-controls="directoriesPanel">Directories (0)</button>
  </div>
  <div class="result-columns">
    <section class="result-section" id="filesPanel" role="tabpanel" aria-labelledby="filesTab">
      <ul class="results" id="filesResults"></ul>
    </section>
    <section class="result-section" id="directoriesPanel" role="tabpanel" aria-labelledby="directoriesTab" hidden>
      <ul class="results" id="directoriesResults"></ul>
    </section>
  </div>
  <div class="result-menu" id="resultMenu" role="menu" hidden>
    <button type="button" role="menuitem" data-copy="name">Copy File Name</button>
    <button type="button" role="menuitem" data-copy="path">Copy Full Path</button>
  </div>
  <script>
    const vscode = acquireVsCodeApi();
    const searchForm = document.getElementById("searchForm");
    const connection = document.getElementById("connection");
    const value = document.getElementById("value");
    const directory = document.getElementById("directory");
    const maxResults = document.getElementById("maxResults");
    const excludePatterns = document.getElementById("excludePatterns");
    const defaultExcludes = document.getElementById("defaultExcludes");
    const helps = document.querySelectorAll(".help");
    const tooltips = document.querySelectorAll(".tooltip");
    const searchButton = document.getElementById("search");
    const toggleSearchOptions = document.getElementById("toggleSearchOptions");
    const searchOptions = document.getElementById("searchOptions");
    const searchOptionsSummary = document.getElementById("searchOptionsSummary");
    const searchDirectorySummary = document.getElementById("searchDirectorySummary");
    const maxResultsSummary = document.getElementById("maxResultsSummary");
    const excludePatternsSummary = document.getElementById("excludePatternsSummary");
    const openSearchSettings = document.getElementById("openSearchSettings");
    const clearButton = document.getElementById("clear");
    const summary = document.getElementById("summary");
    const filesTab = document.getElementById("filesTab");
    const directoriesTab = document.getElementById("directoriesTab");
    const filesPanel = document.getElementById("filesPanel");
    const directoriesPanel = document.getElementById("directoriesPanel");
    const filesResults = document.getElementById("filesResults");
    const directoriesResults = document.getElementById("directoriesResults");
    const resultMenu = document.getElementById("resultMenu");
    let contextResult;

    function selectResultTab(tab) {
      const filesSelected = tab === filesTab;
      filesTab.setAttribute("aria-selected", String(filesSelected));
      directoriesTab.setAttribute("aria-selected", String(!filesSelected));
      filesPanel.hidden = !filesSelected;
      directoriesPanel.hidden = filesSelected;
    }

    filesTab.addEventListener("click", () => selectResultTab(filesTab));
    directoriesTab.addEventListener("click", () => selectResultTab(directoriesTab));
    [filesTab, directoriesTab].forEach((tab) => {
      tab.addEventListener("keydown", (event) => {
        if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
        event.preventDefault();
        const nextTab = tab === filesTab ? directoriesTab : filesTab;
        selectResultTab(nextTab);
        nextTab.focus();
      });
    });

    function updateDefaultExcludesState() {
      const active = defaultExcludes.getAttribute("aria-pressed") === "true";
      defaultExcludes.classList.toggle("active", active);
    }

    updateDefaultExcludesState();

    function updateSearchOptionsSummary() {
      searchDirectorySummary.textContent = directory.value.trim() || "the configured root";
      maxResultsSummary.textContent = maxResults.value;
      excludePatternsSummary.textContent = excludePatterns.value.trim() || "no patterns";
    }

    function normalizeMaxResults() {
      const parsed = Number.parseInt(maxResults.value, 10);
      if (!Number.isInteger(parsed) || parsed < 1) {
        maxResults.value = "<%= defaultMaxResults %>";
      } else {
        maxResults.value = String(parsed);
      }
      updateSearchOptionsSummary();
    }

    updateSearchOptionsSummary();

    function toggleSearchOptionsVisibility() {
      const expanded = toggleSearchOptions.getAttribute("aria-expanded") === "true";
      toggleSearchOptions.setAttribute("aria-expanded", String(!expanded));
      toggleSearchOptions.setAttribute("aria-label", `${expanded ? "Show" : "Hide"} search options`);
      toggleSearchOptions.title = `${expanded ? "Show" : "Hide"} search options`;
      searchOptions.hidden = expanded;
    }

    toggleSearchOptions.addEventListener("click", toggleSearchOptionsVisibility);
    searchOptionsSummary.addEventListener("dblclick", () => {
      if (searchOptions.hidden) toggleSearchOptionsVisibility();
    });

    function clearResults() {
      filesResults.replaceChildren();
      directoriesResults.replaceChildren();
      filesTab.textContent = "Files (0)";
      directoriesTab.textContent = "Directories (0)";
    }

    function hideResultMenu() {
      resultMenu.hidden = true;
      contextResult = undefined;
    }

    function showResultMenu(event, result) {
      event.preventDefault();
      contextResult = result;
      resultMenu.hidden = false;
      resultMenu.style.left = `${Math.min(event.clientX, window.innerWidth - resultMenu.offsetWidth - 4)}px`;
      resultMenu.style.top = `${Math.min(event.clientY, window.innerHeight - resultMenu.offsetHeight - 4)}px`;
      resultMenu.querySelector("button").focus();
    }

    resultMenu.addEventListener("click", (event) => {
      const copyButton = event.target.closest("button[data-copy]");
      if (!copyButton || !contextResult) return;
      const valueToCopy = copyButton.dataset.copy === "name"
        ? contextResult.path.split(/[\\/]/).filter(Boolean).pop() || contextResult.path
        : contextResult.path;
      vscode.postMessage({ type: "copy-search-value", value: valueToCopy });
      hideResultMenu();
    });
    document.addEventListener("click", (event) => {
      if (!resultMenu.contains(event.target)) hideResultMenu();
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") hideResultMenu();
    });

    value.focus();

    function runSearch() {
      normalizeMaxResults();
      const searchValue = value.value.trim();
      if (!searchValue) {
        summary.textContent = "";
        clearResults();
        value.focus();
        return;
      }
      searchButton.disabled = true;
      searchButton.classList.add("searching");
      searchButton.title = "Searching...";
      searchButton.setAttribute("aria-label", "Searching...");
      summary.textContent = "";
      clearResults();
      vscode.postMessage({
        type: "search",
        excludePatternsText: excludePatterns.value,
        useDefaultExcludePatterns: defaultExcludes.getAttribute("aria-pressed") === "true",
        options: {
          connectionId: connection.value,
          searchValue,
          searchDirectory: directory.value.trim(),
          maxResults: Number.parseInt(maxResults.value, 10),
          excludePatterns: excludePatterns.value.split(",").map((pattern) => pattern.trim()).filter(Boolean),
        },
      });
    }
    searchForm.addEventListener("submit", (event) => {
      event.preventDefault();
      runSearch();
    });
    clearButton.addEventListener("click", () => {
      value.value = "";
      summary.textContent = "";
      clearResults();
      value.focus();
    });
    defaultExcludes.addEventListener("click", () => {
      const active = defaultExcludes.getAttribute("aria-pressed") === "true";
      defaultExcludes.setAttribute("aria-pressed", String(!active));
      updateDefaultExcludesState();
    });
    directory.addEventListener("input", updateSearchOptionsSummary);
    excludePatterns.addEventListener("input", updateSearchOptionsSummary);
    maxResults.addEventListener("blur", normalizeMaxResults);
    openSearchSettings.addEventListener("click", (event) => {
      event.preventDefault();
      vscode.postMessage({ type: "open-search-settings" });
    });
    tooltips.forEach((tooltip) => {
      tooltip.addEventListener("click", (event) => event.preventDefault());
    });
    document.addEventListener("click", (event) => {
      const helpButton = event.target instanceof Element && event.target.closest(".help-button");
      const help = helpButton?.closest(".help");
      if (help) {
        const shouldOpen = !help.classList.contains("open");
        helps.forEach((otherHelp) => {
          otherHelp.classList.toggle("open", otherHelp === help && shouldOpen);
        });
        return;
      }
      helps.forEach((help) => {
        if (!help.contains(event.target)) help.classList.remove("open");
      });
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !event.isComposing) {
        helps.forEach((help) => help.classList.remove("open"));
      }
    });
    connection.addEventListener("change", () => {
      vscode.postMessage({ type: "connection-change", connectionId: connection.value });
      value.focus();
    });
    window.addEventListener("keydown", (event) => {
      const isFindShortcut = (event.metaKey || event.ctrlKey)
        && !event.altKey
        && event.key.toLowerCase() === "f";
      if (!isFindShortcut) {
        return;
      }
      event.preventDefault();
      value.focus();
      value.select();
    });
    window.addEventListener("message", (event) => {
      const message = event.data;
      searchButton.disabled = false;
      searchButton.classList.remove("searching");
      searchButton.title = "Search";
      searchButton.setAttribute("aria-label", "Search");
      if (message.type === "connection-default") {
        directory.value = message.searchDirectory;
        updateSearchOptionsSummary();
        return;
      }
      if (message.type === "search-context") {
        connection.value = message.connectionId;
        directory.value = message.searchDirectory;
        updateSearchOptionsSummary();
        value.focus();
        return;
      }
      if (message.type === "error") {
        summary.textContent = message.message;
        summary.className = "summary error";
        return;
      }
      if (message.type !== "results") return;
      summary.className = "summary";
      summary.textContent = "";
      const fileCount = message.results.filter((result) => !result.isDirectory).length;
      const directoryCount = message.results.length - fileCount;
      filesTab.textContent = `Files (${fileCount})`;
      directoriesTab.textContent = `Directories (${directoryCount})`;
      message.results.forEach((result) => {
        const item = document.createElement("li");
        item.className = "result";
        const button = document.createElement("button");
        button.type = "button";
        button.innerHTML = `<span class="name"></span><span class="path"></span>`;
        button.querySelector(".name").textContent = result.name;
        button.querySelector(".path").textContent = result.path;
        button.addEventListener("click", () => {
          hideResultMenu();
          item.classList.add("visited");
          vscode.postMessage({ type: "open", connectionId: result.connectionId, path: result.path, isDirectory: result.isDirectory });
        });
        item.addEventListener("contextmenu", (event) => showResultMenu(event, result));
        item.appendChild(button);
        (result.isDirectory ? directoriesResults : filesResults).appendChild(item);
      });
    });
  </script>
</body>

</html>