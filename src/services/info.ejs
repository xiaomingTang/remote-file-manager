<!doctype html>
<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
      :root {
        color-scheme: light dark;
      }

      body {
        max-width: 820px;
        min-width: 360px;
        padding: 30px 34px;
        color: var(--vscode-foreground);
        font-family: var(--vscode-font-family);
        font-size: var(--vscode-font-size);
      }

      h1 {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 1.5em;
        font-weight: 600;
        margin: 0 0 28px;
        overflow-wrap: anywhere;
      }

      .icon {
        flex: 0 0 auto;
        font-size: 1.05em;
      }

      .row {
        display: grid;
        grid-template-columns: minmax(96px, 18%) 1fr;
        gap: 22px;
        padding: 7px 0;
      }

      .divider {
        margin: 12px 0;
        border-top: 1px solid
          color-mix(in srgb, var(--vscode-panel-border) 55%, transparent);
      }

      .label {
        text-transform: capitalize;
      }

      .value {
        overflow-wrap: anywhere;
        line-height: 1.45;
      }

      a {
        color: var(--vscode-textLink-foreground);
      }

      .label,
      .secondary-value,
      .owner-prefix {
        color: color-mix(
          in srgb,
          var(--vscode-descriptionForeground) 50%,
          transparent
        );
      }

      .owner-prefix {
        user-select: none;
      }
    </style>
  </head>

  <body>
    <h1>
      <span class="icon" aria-hidden="true"><%- icon %></span>
      <span> <%= nodeLabel %></span>
    </h1>
    <div class="row">
      <div class="label">Path</div>
      <div class="value">
        <% path.forEach((link, index)=> { if (index> 0) { %>
        <span> --&gt; </span>
        <% } if (link.uri) { %>
        <a href="<%= link.uri %>" data-open-uri="<%= link.uri %>"
          ><%= link.text %></a
        >
        <% } else { %>
        <%= link.text %>
        <% } %>
        <% }); %>
      </div>
    </div>
    <div class="divider" aria-hidden="true"></div>
    <div class="row">
      <div class="label">Size</div>
      <div class="value">
        <span>
          <%= size.value %>
        </span>
        <% if (size.exact) { %>
        <span class="secondary-value">/ <%= size.exact %></span>
        <% } %>
      </div>
    </div>
    <div class="row">
      <div class="label">Permission</div>
      <div class="value"><%= permission %></div>
    </div>
    <div class="row">
      <div class="label">Owner</div>
      <div class="value">
        <span class="owner-part"
          ><span class="owner-prefix" aria-hidden="true">u: </span>
          <%= owner.user %>
        </span>
        <span> / </span>
        <span class="owner-part"
          ><span class="owner-prefix" aria-hidden="true">g: </span>
          <%= owner.group %>
        </span>
      </div>
    </div>
    <div class="divider" aria-hidden="true"></div>
    <div class="row">
      <div class="label">Created</div>
      <div class="value"><%= created %></div>
    </div>
    <div class="row">
      <div class="label">Modified</div>
      <div class="value"><%= modified %></div>
    </div>
    <script>
      const vscode = acquireVsCodeApi();
      const links = document.querySelectorAll("a[data-open-uri]");
      links.forEach((link) => {
        link.addEventListener("click", (event) => {
          event.preventDefault();
          vscode.postMessage({
            type: "open-uri",
            uri: link.dataset.openUri,
          });
        });
      });
    </script>
  </body>
</html>
